{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fefeconnect.com/schemas/verification-result.schema.json",
  "title": "FEFE Connect normalized verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "subject",
    "claim",
    "jurisdiction",
    "authority",
    "match",
    "findings",
    "evidence",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "verification_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "track", "internal_subject_id"],
      "properties": {
        "subject_type": {
          "enum": ["person", "organization"]
        },
        "track": {
          "enum": ["legal", "healthcare", "operating_entity"]
        },
        "internal_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "claimed_name"],
      "properties": {
        "claim_type": {
          "enum": [
            "professional_standing",
            "entity_record",
            "organization_affiliation",
            "npi_record",
            "account_identity"
          ]
        },
        "claimed_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "identifier_type": {
          "type": "string",
          "maxLength": 100
        },
        "claimed_identifier": {
          "type": "string",
          "maxLength": 200
        },
        "profession_or_entity_type": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code"],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "subdivision_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_url",
        "access_mode",
        "automation_authorized",
        "checked_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "terms_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "source_record_id_masked": {
          "type": "string",
          "maxLength": 200
        },
        "access_mode": {
          "enum": ["official_api", "approved_bulk_feed", "manual_primary_source"]
        },
        "automation_authorized": {
          "type": "boolean"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier"],
      "properties": {
        "name": {
          "enum": ["exact", "accepted_alias", "ambiguous", "mismatch", "not_applicable"]
        },
        "identifier": {
          "enum": ["exact", "ambiguous", "mismatch", "not_found", "not_applicable"]
        },
        "location": {
          "enum": ["exact", "partial", "mismatch", "not_checked", "not_applicable"]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "outcome"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "maxLength": 100
          },
          "source_value": {
            "type": ["string", "number", "boolean", "null"]
          },
          "normalized_value": {
            "type": ["string", "number", "boolean", "null"]
          },
          "outcome": {
            "enum": ["pass", "review", "fail", "informational"]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_method", "adapter_version", "rules_version", "sha256"],
      "properties": {
        "capture_method": {
          "enum": ["adapter", "manual"]
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rules_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "private_object_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "reason_codes",
        "decided_at",
        "public_claim"
      ],
      "properties": {
        "status": {
          "enum": ["verified", "needs_review", "not_verified", "source_unavailable", "expired"]
        },
        "method": {
          "enum": ["automated", "manual"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "maxLength": 100
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_claim": {
          "type": "string",
          "maxLength": 500
        },
        "review_note": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
