{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fefeconnect.com/schemas/professional-record-detail.schema.json",
  "title": "FEFE Connect member-safe professional record detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "professional_type",
    "record_status",
    "person",
    "profile_state",
    "record",
    "disclosures",
    "actions",
    "request_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "professional_type": { "enum": ["legal", "mental-health"] },
    "record_status": { "enum": ["in_review", "current", "action_required", "expired", "inactive"] },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "organization"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "organization": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "profile_state": { "enum": ["not_created", "submitted_only", "hidden", "published"] },
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/legalRecord" },
        { "$ref": "#/$defs/mentalHealthRecord" }
      ]
    },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 700 }
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/action" }
    },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "professional_type": { "const": "legal" } } },
      "then": { "properties": { "record": { "$ref": "#/$defs/legalRecord" } } }
    },
    {
      "if": { "properties": { "professional_type": { "const": "mental-health" } } },
      "then": { "properties": { "record": { "$ref": "#/$defs/mentalHealthRecord" } } }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "label", "target"],
      "properties": {
        "action": {
          "enum": ["view_claim", "report_change", "request_correction", "contact_support"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(/[^\\s]*|mailto:hello@fefeconnect\\.com(?:\\?[^\\s]*)?)$"
        },
        "resource_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "homepage"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "homepage": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "subdivision_code", "display_name"],
      "properties": {
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "subdivision_code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "claimBase": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "label",
        "status",
        "authority",
        "jurisdiction",
        "checked_at",
        "valid_through",
        "supported_wording",
        "member_explanation",
        "limitation",
        "actions"
      ],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "claim_type": {
          "enum": ["professional_standing", "entity_record", "organization_affiliation", "npi_record"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": {
          "enum": ["not_started", "in_review", "temporarily_unavailable", "verified", "not_verified", "expired"]
        },
        "authority": {
          "oneOf": [{ "$ref": "#/$defs/authority" }, { "type": "null" }]
        },
        "jurisdiction": {
          "oneOf": [{ "$ref": "#/$defs/jurisdiction" }, { "type": "null" }]
        },
        "masked_identifier": { "type": ["string", "null"], "maxLength": 100 },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "valid_through": { "type": ["string", "null"], "format": "date-time" },
        "supported_wording": { "type": ["string", "null"], "maxLength": 500 },
        "member_explanation": { "type": "string", "minLength": 1, "maxLength": 700 },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 700 },
        "actions": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "legalStandingClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/claimBase" },
        {
          "type": "object",
          "required": ["credential"],
          "properties": {
            "claim_type": { "const": "professional_standing" },
            "credential": {
              "type": "object",
              "additionalProperties": false,
              "required": ["credential_type", "credential_label", "admission_date"],
              "properties": {
                "credential_type": { "const": "bar_admission" },
                "credential_label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "admission_date": { "type": ["string", "null"], "format": "date" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "mentalHealthStandingClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/claimBase" },
        {
          "type": "object",
          "required": ["credential"],
          "properties": {
            "claim_type": { "const": "professional_standing" },
            "credential": {
              "type": "object",
              "additionalProperties": false,
              "required": ["credential_type", "profession", "license_type"],
              "properties": {
                "credential_type": { "const": "professional_license" },
                "profession": { "type": "string", "minLength": 1, "maxLength": 200 },
                "license_type": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "entityClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/claimBase" },
        {
          "type": "object",
          "required": ["organization_name"],
          "properties": {
            "claim_type": { "const": "entity_record" },
            "organization_name": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "affiliationClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/claimBase" },
        {
          "type": "object",
          "required": ["organization_name", "role_label"],
          "properties": {
            "claim_type": { "const": "organization_affiliation" },
            "organization_name": { "type": "string", "minLength": 1, "maxLength": 300 },
            "role_label": { "type": ["string", "null"], "maxLength": 120 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "npiClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/claimBase" },
        {
          "type": "object",
          "required": ["enumeration_type", "taxonomy_summary", "licensure_disclaimer"],
          "properties": {
            "claim_type": { "const": "npi_record" },
            "enumeration_type": { "type": ["string", "null"], "maxLength": 100 },
            "taxonomy_summary": { "type": ["string", "null"], "maxLength": 300 },
            "licensure_disclaimer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "legalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bar_admissions", "firm_entity", "firm_affiliation"],
      "properties": {
        "kind": { "const": "legal_record" },
        "bar_admissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/legalStandingClaim" }
        },
        "firm_entity": {
          "oneOf": [{ "$ref": "#/$defs/entityClaim" }, { "type": "null" }]
        },
        "firm_affiliation": {
          "oneOf": [{ "$ref": "#/$defs/affiliationClaim" }, { "type": "null" }]
        }
      }
    },
    "mentalHealthRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "licenses", "npi_corroboration", "practice_entity", "practice_affiliation"],
      "properties": {
        "kind": { "const": "mental_health_record" },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/mentalHealthStandingClaim" }
        },
        "npi_corroboration": {
          "oneOf": [{ "$ref": "#/$defs/npiClaim" }, { "type": "null" }]
        },
        "practice_entity": {
          "oneOf": [{ "$ref": "#/$defs/entityClaim" }, { "type": "null" }]
        },
        "practice_affiliation": {
          "oneOf": [{ "$ref": "#/$defs/affiliationClaim" }, { "type": "null" }]
        }
      }
    }
  }
}
